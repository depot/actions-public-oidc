# AWS Configuration
AWS_REGION=us-east-1
TABLE_NAME=oidc-data

# Application secrets (these would be stored in AWS Secrets Manager or Parameter Store)
ADMIN_TOKEN=your-admin-token

# GitHub API tokens - use GITHUB_TOKENS for multiple tokens (comma-separated) to distribute rate limits
# GITHUB_TOKENS=ghp_token1,ghp_token2,ghp_token3
GITHUB_TOKEN=your-github-token
